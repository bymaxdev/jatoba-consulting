# Copie para .env.local e preencha.

# Chave API da Resend — https://resend.com/
RESEND_API_KEY=

# Caixa de destino das mensagens do formulário
CONTACT_TO_EMAIL=

# Remetente verificado na Resend (domínio deve estar verificado na plataforma).
# Exemplo: "Jatoba Site <onboarding@resend.dev>" (apenas para testes na Resend).
CONTACT_FROM_EMAIL=
